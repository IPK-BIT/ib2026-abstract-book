---
import { getEntry } from 'astro:content';

interface Props {
  id: string; // Can be a single id "key1" or multiple comma-separated ids "key1, key2"
}

const { id } = Astro.props;

// 1. Split the incoming ids string into a clean array of lowercase keys
const targetIds = id.split(',').map(item => item.trim().toLowerCase());

const currentUrl = Astro.url.pathname;
let referencesArray: any[] = [];

// 2. Fetch the current abstract entry from the content layer to read its global reference order
const slug = currentUrl.split('/abstracts/')[1]?.replace(/\/$/, '');
if (slug) {
  const docEntry = await getEntry('docs', `abstracts/${slug}`);
  if (docEntry?.data?.references) {
    referencesArray = docEntry.data.references;
  }
}

// 3. Map our target keys to their actual 1-based index positions
const indices: number[] = targetIds
  .map(targetId => {
    const idx = referencesArray.findIndex((ref: any) => {
      const refKey = typeof ref === 'object' && ref !== null ? ref.id : ref;
      return refKey?.toLowerCase() === targetId;
    });
    return idx !== -1 ? idx + 1 : null;
  })
  .filter((num): num is number => num !== null)
  .sort((a, b) => a - b); // Keep numbers sorted sequentially

// 4. Compress consecutive indices into ranges (e.g., [1, 2, 3, 5] -> "1-3, 5")
function formatRanges(nums: number[]): string {
  if (nums.length === 0) return '?';
  
  const result: string[] = [];
  let start = nums[0];
  let end = nums[0];

  for (let i = 1; i <= nums.length; i++) {
    // If consecutive, extend the range end
    if (i < nums.length && nums[i] === end + 1) {
      end = nums[i];
    } else {
      // Range complete: compress if it spans 3 or more elements
      if (end - start >= 2) {
        result.push(`${start}-${end}`);
      } else if (end !== start) {
        // Just two items, join with a comma (e.g., "1,2")
        result.push(`${start}, ${end}`);
      } else {
        result.push(`${start}`);
      }
      
      if (i < nums.length) {
        start = nums[i];
        end = nums[i];
      }
    }
  }
  return result.join(', ');
}

const displayString = formatRanges(indices);
// For the anchor link, link to the first ID in the multiple sequence
const primaryAnchor = targetIds[0] || '';
// Full list of target ids, for the client script to highlight every reference in the group
const refIdsAttr = targetIds.join(',');
---

<a
  href={`#ref-${primaryAnchor}`}
  class="inline-citation"
  title={`Jump to reference section`}
  data-ref-ids={refIdsAttr}
>[{displayString}]</a>

<script>
  // Highlights every reference belonging to a (possibly multi-id) citation.
  // Native :target / anchor scrolling still only ever jumps to the first id
  // (that's the href), this just adds the highlight class to the rest too.

  function highlightReferences(ids: string[]) {
    document.querySelectorAll('.reference-card.is-cited-target').forEach((el) => {
      el.classList.remove('is-cited-target');
    });
    ids.forEach((id) => {
      const target = document.getElementById(`ref-${id}`);
      if (target) target.classList.add('is-cited-target');
    });
  }

  function highlightFromCurrentHash() {
    const match = window.location.hash.match(/^#ref-(.+)$/);
    if (match) highlightReferences([decodeURIComponent(match[1])]);
  }

  let skipNextHashChange = false;

  function handleCitationClick(event: MouseEvent) {
    const link = (event.target as HTMLElement)?.closest?.('.inline-citation');
    if (!link) return;
    const idsAttr = link.getAttribute('data-ref-ids');
    if (!idsAttr) return;
    // The browser is about to update the hash to the primary id on its own;
    // skip the resulting hashchange so it doesn't overwrite our full highlight.
    skipNextHashChange = true;
    highlightReferences(idsAttr.split(','));
  }

  function handleHashChange() {
    if (skipNextHashChange) {
      skipNextHashChange = false;
      return;
    }
    highlightFromCurrentHash();
  }

  // Click handling is delegated on document, so it stays valid across all
  // Cite instances; guard against re-binding if this script runs again
  // (e.g. after a client-side navigation).
  const win = window as unknown as { __citeHighlightInit?: boolean };
  if (!win.__citeHighlightInit) {
    win.__citeHighlightInit = true;
    document.addEventListener('click', handleCitationClick);
    window.addEventListener('hashchange', handleHashChange);
  }

  // Re-apply on initial load and on Astro client-side page transitions.
  highlightFromCurrentHash();
  document.addEventListener('astro:page-load', highlightFromCurrentHash);
</script>

<style>
  .inline-citation {
    color: var(--sl-color-text-accent);
    font-weight: 500;
    text-decoration: none;
    display: inline-block;
    transition: transform 0.15s ease;
  }
  .inline-citation:hover {
    text-decoration: underline;
    transform: translateY(-1px);
  }
</style>