---
// src/components/ReferenceCard.astro (or your respective component file name)
import { getEntry } from 'astro:content';
import citations from '../data/citations.json'; // 1. Import build-time citation counts

interface Props {
  id: string;
  number: number;
}

const { id, number } = Astro.props;
const entry = await getEntry('references', id.toLowerCase());

if (!entry) return null;

// Destructure the raw data fields, explicitly including doi
const { type, author, title, journal, year, volume, pages, publisher, url, doi } = entry.data;

// --- Link & Fallback Logic ---
let hrefLink = '';
let displayLinkText = '';
let isDoi = false;
let cleanDoi = '';

if (doi) {
  cleanDoi = doi.replace(/^https?:\/\/doi\.org\//, '');
  hrefLink = `https://doi.org/${cleanDoi}`;
  displayLinkText = `doi:${cleanDoi}`;
  isDoi = true;
} else if (url) {
  hrefLink = url;
  displayLinkText = url;
}

// --- Lookup Citation Count from Build Cache ---
const citationCount = (cleanDoi && citations[cleanDoi as keyof typeof citations]) ? citations[cleanDoi as keyof typeof citations] : 0;

// --- Elsevier Vancouver Author Formatter ---
function formatVancouverAuthors(authorStr: string | undefined): string {
  if (!authorStr) return '';
  
  const authors = authorStr.split(/\s+and\s+/i).map(name => name.trim());
  
  const formattedArray = authors.map(name => {
    if (name.startsWith('{') && name.endsWith('}')) {
      return name.replace(/^\{+|\}+$/g, '').trim();
    }

    if (name.includes(',')) {
      const parts = name.split(',');
      const lastName = parts[0].trim();
      const firstNames = parts[1].trim().split(/\s+/);
      const initials = firstNames.map(n => n[0].toUpperCase()).join('');
      return `${lastName} ${initials}`;
    } else {
      const parts = name.split(/\s+/);
      if (parts.length === 1) return parts[0];
      const lastName = parts.pop();
      const initials = parts.map(n => n[0].toUpperCase()).join('');
      return `${lastName} ${initials}`;
    }
  });

  if (formattedArray.length > 6) {
    return formattedArray.slice(0, 3).join(', ') + ', et al';
  }
  
  return formattedArray.join(', ');
}

const formattedAuthors = formatVancouverAuthors(author);
const cleanTitle = title ? title.replace(/[\{\}]/g, '') : '';
const cleanYear = year ? year.trim() : '';
---

<div class="reference-card" id={`ref-${id.toLowerCase()}`}>
  <span class="ref-citation-number">[{number}]</span>
  
  <span class="ref-details">
    {formattedAuthors && `${formattedAuthors}. `}
    <span class="ref-title">{cleanTitle}{cleanTitle?.endsWith('.') ? '' : '.'}</span>
    
    {type === 'article' && (
      <>
        {journal && <span class="ref-journal"> {journal}</span>}
        {cleanYear && ` ${cleanYear}`}
        {volume && `;${volume}`}
        {pages && `:${pages}`}
        .
      </>
    )}

    {(type === 'misc' || type === 'phdthesis' || type === 'book') && (
      <>
        {publisher && <span class="ref-publisher"> {publisher}</span>}
        {publisher && cleanYear ? '; ' : ' '}
        {cleanYear && `${cleanYear}.`}
      </>
    )}

    {/* Metadata & OpenAlex Metrics Row */}
    <div class="citation-meta-row">
      {hrefLink && (
        <div class="citation-link-wrapper">
          <a href={hrefLink} target="_blank" rel="noopener noreferrer" class="ref-url-link">
            {displayLinkText}
          </a>
        </div>
      )}

      {isDoi && (
        <a 
          href={`https://doi.org/${cleanDoi}`}
          target="_blank" 
          rel="noopener noreferrer" 
          class="openalex-badge" 
          title="View citation metrics on OpenAlex"
        >
          <svg class="openalex-icon" viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span class="badge-text">Cited by <strong>{citationCount}</strong></span>
        </a>
      )}
    </div>
  </span>
</div>

<style>
  .reference-card {
    display: flex;
    align-items: baseline; 
    gap: 0.75rem; 
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--sl-color-gray-6);
    scroll-margin-top: 5rem;
  }
  .ref-citation-number {
    font-weight: bold;
    color: var(--sl-color-text-accent);
    flex-shrink: 0;
    white-space: nowrap;
  }
  .ref-details {
    color: var(--sl-color-gray-2);
    width: 100%;
  }
  .ref-title {
    color: var(--sl-color-white);
  }
  .ref-journal {
    font-style: normal; 
  }
  .citation-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.25rem;
  }
  .citation-link-wrapper {
    font-size: var(--sl-text-xs);
  }
  .ref-url-link {
    display: inline-block;
    word-break: break-all;
    color: var(--sl-color-text-accent);
    text-decoration: underline;
  }
  .openalex-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    background-color: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    padding: 0.1rem 0.5rem;
    border-radius: 12px;
    text-decoration: none;
    border: 1px solid var(--sl-color-gray-5);
    transition: background-color 0.2s ease;
  }
  .openalex-badge:hover {
    background-color: var(--sl-color-gray-5);
    color: var(--sl-color-white);
  }
  .openalex-icon {
    opacity: 0.7;
  }
  .reference-card:target,
  .reference-card.is-cited-target {
    background-color: var(--sl-color-gray-6);
    padding-left: 0.5rem;
    border-radius: 4px;
  }
</style>