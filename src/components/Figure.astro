---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  caption: string;
  width?: number;
  number?: number | string; // e.g. "Fig. 1:"
  full?: boolean; // stretch to full content width instead of intrinsic size
  href?: string; // wrap the image in a link
}

const { src, caption, width, number, full = false, href } = Astro.props;

const altText = caption.replace(/<[^>]*>/g, '');
const isLocalAsset = typeof src === 'object';
---

<figure class:list={['sl-figure', { 'sl-figure-full': full }]}>
  {href ? (
    <a href={href} target="_blank" rel="noopener noreferrer">
      {isLocalAsset ? (
        <Image src={src as ImageMetadata} alt={altText} width={width} />
      ) : (
        <img src={src as string} alt={altText} width={width} />
      )}
    </a>
  ) : isLocalAsset ? (
    <Image src={src as ImageMetadata} alt={altText} width={width} />
  ) : (
    <img src={src as string} alt={altText} width={width} />
  )}
  <figcaption>
    {number !== undefined && <strong>Fig. {number}:</strong>}{' '}
    <span set:html={caption} />
  </figcaption>
</figure>

<style>
  .sl-figure {
    margin: 2rem auto;
    max-width: fit-content;
  }

  .sl-figure img {
    display: block;
    margin: 0 auto;
    max-width: 100%;
    height: auto;
    border-radius: 0.25rem;
    border: 1px solid var(--sl-color-gray-5);
  }

  .sl-figure-full {
    max-width: 100%;
  }

  .sl-figure-full img {
    width: 100%;
  }

  .sl-figure figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    text-align: left;
    line-height: 1.4;
  }

  .sl-figure figcaption strong {
    color: var(--sl-color-white);
  }
</style>