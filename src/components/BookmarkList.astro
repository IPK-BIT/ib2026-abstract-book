---
import { getCollection } from 'astro:content';

const authorNameBySlug = Object.fromEntries(
  (await getCollection('authors')).map((author) => [author.id, author.data.name])
);
---

<div id="highlights-root">
  <div id="highlights-empty" class="highlights-empty" hidden>
    <div class="specimen-empty">
      <div class="empty-icon-wrapper">
        <svg class="empty-star" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2.5l2.9 6.6 7.1.7-5.4 4.8 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.8l7.1-.7z" />
        </svg>
      </div>
      <h3>No highlights collected</h3>
      <p>
        Your reading list is empty. Star abstracts across the program to add them here.
      </p>
      <a href="/ib2026-abstract-book/abstracts" class="empty-cta">Explore schedule</a>
    </div>
  </div>
  <ul
    id="highlights-list"
    class="highlights-list"
    aria-live="polite"
    data-author-name-by-slug={JSON.stringify(authorNameBySlug)}
  ></ul>
</div>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap');

  #highlights-root {
    --bm-tab: #085041;
    --bm-tab-text: #E1F5EE;
    --bm-accent: #0B6E4F;
    --bm-remove: #9A3B34;
    --bm-serif: 'Source Serif 4', Georgia, 'Times New Roman', serif;
  }

  [data-theme='dark'] #highlights-root {
    --bm-tab: #0F6E56;
    --bm-tab-text: #E1F5EE;
    --bm-accent: #5DCAA5;
    --bm-remove: #F09595;
  }

  .highlights-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Specimen Card Styling */
  .highlight-item {
    display: flex;
    align-items: stretch;
    background: var(--sl-color-bg, #ffffff);
    border: 1px solid var(--sl-color-gray-5, #cbd5e1);
    border-radius: 0.75rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    overflow: hidden;
  }

  .highlight-item:hover {
    border-color: var(--bm-accent);
    box-shadow: 0 4px 10px -2px rgba(8, 80, 65, 0.1);
  }

  /* Index tab */
  .highlight-index {
    flex-shrink: 0;
    width: 2.125rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bm-tab);
  }

  .highlight-index span {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--bm-tab-text);
  }

  .highlight-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .highlight-info {
    padding: 1.1rem 1.25rem 0.85rem 1.25rem;
    box-sizing: border-box;
  }

  .highlight-citation {
    display: inline;
    font-family: var(--bm-serif);
    color: var(--sl-color-text, #0f172a);
    line-height: 1.55;
    font-size: 1rem;
  }

  .highlight-title {
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  .highlight-item .authors {
    color: var(--sl-color-gray-3, #64748b);
    font-weight: 400;
  }

  .highlight-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1.25rem;
    border-top: 1px solid var(--sl-color-gray-6, #e2e8f0);
    box-sizing: border-box;
  }

  .go-to-abstract {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--bm-accent);
    text-decoration: none;
  }

  .go-to-abstract:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .go-to-abstract svg {
    width: 0.8rem;
    height: 0.8rem;
    transition: transform 0.15s ease;
  }

  .go-to-abstract:hover svg {
    transform: translateX(2px);
  }

  .highlight-item .remove-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: transparent;
    border: 1px solid var(--sl-color-gray-5, #cbd5e1);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--sl-color-gray-3, #64748b);
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .highlight-item .remove-btn svg {
    width: 0.7rem;
    height: 0.7rem;
  }

  .highlight-item .remove-btn:hover {
    border-color: var(--bm-remove);
    color: var(--bm-remove);
  }

  .highlight-item .remove-btn:active {
    transform: scale(0.97);
  }

  /* Empty State Styling */
  .highlights-empty {
    margin: 2rem 0;
  }

  .specimen-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4.5rem 2rem;
    background: var(--sl-color-bg-nav, #f8fafc);
    border: 1px solid var(--sl-color-gray-5, #cbd5e1);
    border-radius: 1rem;
  }

  .empty-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    background-color: var(--sl-color-bg, #fff);
    border: 1px solid var(--sl-color-gray-5, #cbd5e1);
    border-radius: 50%;
    margin-bottom: 1rem;
  }

  .highlights-empty .empty-star {
    width: 1.5rem;
    height: 1.5rem;
    fill: var(--bm-accent, #0B6E4F);
  }

  .highlights-empty h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--sl-color-text, #0f172a);
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.01em;
  }

  .highlights-empty p {
    font-size: 0.95rem;
    color: var(--sl-color-gray-3, #64748b);
    max-width: 380px;
    margin: 0 0 1.75rem 0;
    line-height: 1.5;
  }

  .highlights-empty .empty-cta {
    display: inline-flex;
    align-items: center;
    font-weight: 600;
    font-size: 0.875rem;
    padding: 0.65rem 1.4rem;
    background-color: var(--bm-accent, #0B6E4F);
    color: white;
    border-radius: 999px;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .highlights-empty .empty-cta:hover {
    opacity: 0.9;
  }
</style>

<script>
  import {
    getHighlights,
    removeHighlight,
    HIGHLIGHTS_EVENT,
  } from '../scripts/highlights-store.js';

  const listEl = document.getElementById('highlights-list');
  const emptyEl = document.getElementById('highlights-empty');
  const authorNameBySlug: Record<string, string> = listEl
    ? JSON.parse(listEl.dataset.authorNameBySlug || '{}')
    : {};

  if (!listEl || !emptyEl) {
    throw new Error('Bookmark list elements not found.');
  }

  const ARROW_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>';
  const X_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg>';

  function contributionLabel(id: string) {
    const segments = id.split('/').filter(Boolean);
    const last = segments[segments.length - 1] || id;

    const keynoteMatch = last.match(/^keynote-(\d+)$/i);
    if (keynoteMatch) {
      return `Keynote ${keynoteMatch[1]}`;
    }

    return `No. ${last}`;
  }

  function formatAuthors(authors: string) {
    const resolvedAuthors = authors
      .split(',')
      .map((author: string) => author.trim())
      .filter(Boolean)
      .map((author: string) => authorNameBySlug[author] || author);

    const formattedAuthors = resolvedAuthors.map((name: string) => {
      if (name.startsWith('{') && name.endsWith('}')) {
        return name.replace(/^\{+|\}+$/g, '').trim();
      }

      if (name.includes(',')) {
        const parts = name.split(',');
        const lastName = parts[0].trim();
        const firstNames = parts[1].trim().split(/\s+/);
        const initials = firstNames.map((part: string) => part[0].toUpperCase()).join('');
        return `${lastName} ${initials}`;
      }

      const parts = name.split(/\s+/);
      if (parts.length === 1) return parts[0];
      const lastName = parts.pop();
      const initials = parts.map((part: string) => part[0].toUpperCase()).join('');
      return `${lastName} ${initials}`;
    });

    if (formattedAuthors.length > 6) {
      return `${formattedAuthors.slice(0, 3).join(', ')}, et al`;
    }

    return formattedAuthors.join(', ');
  }

  function render() {
    const items = getHighlights().sort((a, b) => b.savedAt - a.savedAt);
    listEl!.innerHTML = '';

    if (items.length === 0) {
      emptyEl!.removeAttribute('hidden');
      listEl!.style.display = 'none';
      return;
    }

    emptyEl!.setAttribute('hidden', '');
    listEl!.style.display = 'flex';

    items.forEach((item) => {
        const li = document.createElement('li');
        li.className = 'highlight-item';

        const indexTab = document.createElement('div');
        indexTab.className = 'highlight-index';
        const indexLabel = document.createElement('span');
        indexLabel.textContent = contributionLabel(item.id);
        indexTab.appendChild(indexLabel);

        const body = document.createElement('div');
        body.className = 'highlight-body';

        const info = document.createElement('div');
        info.className = 'highlight-info';

        const citation = document.createElement('div');
        citation.className = 'highlight-citation';

        if (item.authors) {
          const authors = document.createElement('span');
          authors.className = 'authors';
          authors.textContent = `${formatAuthors(item.authors)}. `;
          citation.appendChild(authors);
        }

        const title = document.createElement('span');
        title.className = 'highlight-title';
        title.textContent = item.title;
        citation.appendChild(title);

        if (!item.title.endsWith('.')) {
          const period = document.createElement('span');
          period.textContent = '.';
          citation.appendChild(period);
        }

        info.appendChild(citation);

        const actions = document.createElement('div');
        actions.className = 'highlight-actions';

        const abstractLink = document.createElement('a');
        abstractLink.className = 'go-to-abstract';
        abstractLink.href = item.id;
        abstractLink.innerHTML = `Go to abstract ${ARROW_ICON}`;
        actions.appendChild(abstractLink);

        const removeBtn = document.createElement('button');
        removeBtn.className = 'remove-btn';
        removeBtn.innerHTML = `${X_ICON}<span>Remove</span>`;
        removeBtn.setAttribute('aria-label', `Remove "${item.title}" from highlights`);
        removeBtn.addEventListener('click', () => removeHighlight(item.id));

        actions.appendChild(removeBtn);

        body.append(info, actions);
        li.append(indexTab, body);
        listEl!.append(li);
    });
  }

  render();
  window.addEventListener(HIGHLIGHTS_EVENT, render);
  document.addEventListener('astro:page-load', render);
</script>